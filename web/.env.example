# Copy to .env.local (never commit it)
PRIVATE_KEY=0x...            # deployer = owner = attestor = treasury = demo sponsor
CONTRACT_ADDRESS=0x...       # from `forge script script/Deploy.s.sol`
RPC_URL=https://testnet-rpc.monad.xyz

# Optional
# DEMO_FAST=1                # relaxes rate limit (0.5s) and daily cap (6) so `npm run simulate -- --fast` can show every rejection reason
# SETTLE_INTERVAL_MS=30000
